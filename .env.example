# CineWise Environment Configuration
# ==================================

# ── TMDB API Configuration (Live Posters, Cast & OTT Availability) ──
# Get your free v3 API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ── Email Service Configuration (Password Reset & Recovery) ──
# When configured, CineWise sends secure HTML password reset emails.
# If left blank, CineWise automatically operates in Development Testing Mode
# where reset links are generated and returned in testing endpoints.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM=CineWise <noreply@cinewise.app>

# ── Application URLs ──
APP_URL=http://localhost:5173
